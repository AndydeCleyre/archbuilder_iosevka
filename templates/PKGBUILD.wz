@require(spacing, pbp_sha256, build_webfonts, hinted, branch, use_custom_name, custom_name)
@(
    name = f"ttf-iosevka-{spacing}-custom"
    if spacing == 'normal':
        plan = 'IosevkaCustom'
        name = 'ttf-iosevka-custom'
    elif spacing == 'quasi-proportional':
        plan = 'IosevkaQpCustom'
    elif spacing == 'quasi-proportional-extension-only':
        plan = 'IosevkaQpeCustom'
    elif spacing == 'fontconfig-mono':
        plan = 'IosevkaFcmCustom'
    else:
        plan = f"Iosevka{spacing.title()}Custom"

    plan_rename = plan
    if use_custom_name:
        import re
        plan_rename = re.sub(r'Iosevka(.*)Custom', custom_name.replace(' ', '') + r'\1', plan)

    if hinted and build_webfonts:
        target = 'contents'
    elif hinted:
        target = 'ttf'
    elif build_webfonts:
        target = 'fonts-unhinted'
    else:
        target = 'ttf-unhinted'
)\
# Maintainer: Andy Kluger <https://t.me/andykluger>
# Contributor: Markus Weimar <mail@@markusweimar.de>
_pkgname=@name
pkgname=${_pkgname}-git
pkgver=1
pkgrel=1
pkgdesc='A slender monospace sans-serif and slab-serif typeface inspired by Pragmata Pro, M+ and PF DIN Mono.'
arch=('any')
url='https://be5invis.github.io/Iosevka/'
license=('custom:OFL')
makedepends=('git' 'nodejs>=12.22.0' 'npm' 'ttfautohint')
depends=()
conflicts=(${_pkgname})
provides=(${_pkgname})
@if spacing == 'term':
replaces=('ttf-iosevka-termlig-custom-git')
@end
source=('private-build-plans.toml.example')
sha256sums=('@pbp_sha256')

prepare () {
  rm -rf Iosevka
  git clone --depth 1 --branch @branch 'https://github.com/be5invis/Iosevka'

  buildplans="$HOME/.config/iosevka/private-build-plans.toml"
  if [[ -f "$buildplans" ]]; then
    cp "$buildplans" Iosevka/
  else
    echo ">>> $buildplans not found, using private-build-plans.toml.example"
    cp private-build-plans.toml.example Iosevka/private-build-plans.toml
  fi
}

pkgver () {
  cd Iosevka
  git log -1 --format=%ct
}

build () {
  cd Iosevka
  npm install
  npm update
  NO_COLOR=1 npm run build -- @{target}::@{plan}
}

package () {
  install -d "${pkgdir}/usr/share/fonts/TTF"
  install -m644 Iosevka/dist/@{plan}/TTF@{'-Unhinted' if not hinted else ''}/*.ttf "${pkgdir}/usr/share/fonts/TTF/"
@if build_webfonts:

  install -d "${pkgdir}/usr/share/fonts/WOFF2"
  install -m644 Iosevka/dist/@{plan}/WOFF2@{'-Unhinted' if not hinted else ''}/*.woff2 "${pkgdir}/usr/share/fonts/WOFF2/"
@if plan_rename != plan:

  cd "${pkgdir}/usr/share/fonts/WOFF2/"
  for f in *.woff2; do
    mv "$f" "${f/@{plan}/@{plan_rename}}"
  done
  cd "${srcdir}"
@end

  printf '%s\n' 'CSS BELOW:'
  cat Iosevka/dist/@{plan}/*.css
  printf '%s\n' 'CSS ABOVE'
@end

@if plan_rename != plan:
  cd "${pkgdir}/usr/share/fonts/TTF/"
  for f in *.ttf; do
    mv "$f" "${f/@{plan}/@{plan_rename}}"
  done
  cd "${srcdir}"

@end
  install -d "${pkgdir}/usr/share/licenses/${pkgname}"
  install -m644 Iosevka/LICENSE.md "${pkgdir}/usr/share/licenses/${pkgname}/"
}
